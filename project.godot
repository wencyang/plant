; Bloomward — grow, prune and cross-pollinate living plants through luminous alien gardens.
config_version=5

[application]
config/name="Bloomward"
config/icon="res://icon.svg"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/description="A living puzzle garden. Steer real-time plant growth with light, prune to split shoots, and cross-pollinate strange wild plants to breed the gifts you need."

[display]
window/size/viewport_width=1600
window/size/viewport_height=1000
window/size/window_width_override=1600
window/size/window_height_override=1000
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/dpi/allow_hidpi=true

[rendering]
renderer/rendering_method="forward_plus"
viewport/hdr_2d=true
anti_aliasing/quality/msaa_2d=2
environment/defaults/default_clear_color=Color(0.02, 0.03, 0.05, 1)
