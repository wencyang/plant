; Plant Auto-Battler — persistent alien conservatory.
config_version=5

[application]
config/name="The Quiet Conservatory"
config/icon="res://icon.svg"
run/main_scene="res://scenes/garden.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/description="A pixel botanical adventure. Explore four biomes, collect wild plants, and grow a lineage."

[display]
window/dpi/allow_hidpi=true
window/size/viewport_width=1440
window/size/viewport_height=1000
window/size/window_width_override=1440
window/size/window_height_override=1000
window/size/min_width=390
window/size/min_height=780
window/stretch/mode="disabled"
window/stretch/aspect="expand"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.027, 0.059, 0.055, 1)

[input]
ui_cancel={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":4194305)]}
